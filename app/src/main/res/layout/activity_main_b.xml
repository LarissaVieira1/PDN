<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivityB">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/courier_prime"
        android:text="PG 2"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/imgIMC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtAlturaBR" />

    <TextView
        android:id="@+id/txtNome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/courier_prime"
        android:text="Nome:"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/txtNomeR"
        app:layout_constraintEnd_toStartOf="@+id/txtNomeR"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtNomeR"
        android:layout_width="193dp"
        android:layout_height="23dp"
        android:layout_marginEnd="60dp"
        android:fontFamily="@font/courier_prime"
        android:text="--"
        android:textColorLink="#041887"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/txtPseoBR"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtPesoB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/courier_prime"
        android:text="Peso:"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/txtPseoBR"
        app:layout_constraintEnd_toStartOf="@+id/txtPseoBR"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtPseoBR"
        android:layout_width="199dp"
        android:layout_height="28dp"
        android:layout_marginEnd="52dp"
        android:fontFamily="@font/courier_prime"
        android:text="--"
        android:textColorLink="#041887"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/txtAlturaBR"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtNomeR" />

    <TextView
        android:id="@+id/txtAlturaB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/courier_prime"
        android:text="Altura:"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/txtAlturaBR"
        app:layout_constraintEnd_toStartOf="@+id/txtAlturaBR"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtAlturaBR"
        android:layout_width="208dp"
        android:layout_height="30dp"
        android:layout_marginEnd="44dp"
        android:fontFamily="@font/courier_prime"
        android:text="--"
        android:textColorLink="#041887"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/textView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtPseoBR" />

    <ImageView
        android:id="@+id/imgIMC"
        android:layout_width="156dp"
        android:layout_height="250dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:srcCompat="@drawable/ic_launcher_background" />

</androidx.constraintlayout.widget.ConstraintLayout>